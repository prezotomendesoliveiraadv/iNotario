# Front (Vite) — copie para .env.local e preencha
# Project Settings > API no Supabase
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# A IA da Artemis roda em Edge Functions (chaves NUNCA ficam no front).
# Configure os segredos do servidor conforme supabase/functions/DEPLOY.md:
#   supabase secrets set ARTEMIS_PROVIDER=anthropic   (ou: gemini)
#   supabase secrets set ANTHROPIC_API_KEY=...      (se provider=anthropic)
#   supabase secrets set GEMINI_API_KEY=...          (se provider=gemini)
#   supabase secrets set OPENAI_API_KEY=...         (voz: STT + TTS)
#   supabase secrets set ARTEMIS_MODEL=claude-sonnet-4-6   (opcional)
